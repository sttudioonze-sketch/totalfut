{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/summit-palestrante-:variant(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/assets/social/summit-palestrante:variant(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, noarchive"
        }
      ]
    },
    {
      "source": "/summit-2026.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/globalsummit",
      "destination": "https://totalfut.com.br/#cursos",
      "permanent": true
    },
    {
      "source": "/blank-1",
      "destination": "https://totalfut.com.br/curso-analise-desempenho-avancada.html",
      "permanent": true
    },
    {
      "source": "/bolaparadaofensiva",
      "destination": "https://totalfut.com.br/curso-bola-parada-ofensiva-tobar.html",
      "permanent": true
    },
    {
      "source": "/cruzamentosnofutebol",
      "destination": "https://totalfut.com.br/curso-cruzamentos-no-futebol.html",
      "permanent": true
    },
    {
      "source": "/leandrozagocaetaticaindividual",
      "destination": "https://totalfut.com.br/curso-tecnica-tatica-individual.html",
      "permanent": true
    },
    {
      "source": "/exerciciostecnicaetaticaindividual",
      "destination": "https://totalfut.com.br/curso-exercicios-tecnica-tatica-individual.html",
      "permanent": true
    },
    {
      "source": "/analisedasbolasparadas",
      "destination": "https://totalfut.com.br/curso-analise-bola-parada-pombo.html",
      "permanent": true
    }
  ]
}
